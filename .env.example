# Demo mode needs no Supabase credentials. Restart after changing these values.
NEXT_PUBLIC_APP_MODE=demo
# To use Supabase accounts and inventory, select connected and replace placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=KEY_PLACEHOLDER
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never put a secret/service-role key in a NEXT_PUBLIC variable.
# Server-only secret key for photo certification and protected platform user administration.
# Ordinary registration/login/facility/inventory/conversation operations use publishable clients.
SUPABASE_SECRET_KEY=

# Referral/watchlist UI switch. Also configure the GitHub Actions worker separately:
# repository Variables for enabled/from/site/project, Secrets for the two keys.
H2H_EMAIL_ENABLED=false
RESEND_API_KEY=
H2H_EMAIL_FROM=
# Dedicated server-only worker key mapping to service_role; never a NEXT_PUBLIC key.
SUPABASE_EMAIL_SECRET_KEY=

# Optional private support screenshots only. Text tickets work without this key.
SUPABASE_SUPPORT_SECRET_KEY=
# Optional public business support address for visitors who cannot sign in.
H2H_SUPPORT_EMAIL=
